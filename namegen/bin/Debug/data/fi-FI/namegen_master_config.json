{
  "project": "GeneSim NameGen v1.3.4",
  "database_version": "Master-DB 1.0",
  "description_fi": "Nimet perustuvat 1860-1970 kuolleiden luetteloihin. Edustaa pitkäikäistä väestöä.",
  "description_en": "Names are based on registries from 1860-1970. Represents long-lived population.",
  "settings": {
    "data_locale": "fi-FI",
    "precise_historical_data": true,
    "use_regional_bonuses": true,
    "deterministic_seed": true,
    "bias_correction": false,
    "default_year": 1900,
    "year_interval": 10,
    "child_max_age": 14
  },
  "data_format": {
    "separator": ";",
    "pair_separator": ",",
    "null_value": "-",
    "columns": ["1860", "1870", "1880", "1890", "1900", "1910", "1920", "1930", "1940", "1950", "1960"],
    "note": "Name is stored only once per row to optimize memory."
  },
  "data_sources": [
