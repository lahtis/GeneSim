<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="namegen" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/namegen" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/namegen" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
				<ExtraCommands>
					<Add before='powershell -Command &quot;(Get-Content include/version.h) -replace &apos;#define VERSION_PATCH \d+&apos;, &apos;#define VERSION_PATCH &apos; + ((Get-Date).DayOfYear) | Set-Content include/version.h&quot;' />
					<Mode after="always" />
				</ExtraCommands>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add directory="include" />
			<Add directory="src" />
		</Compiler>
		<Unit filename="README.md">
			<Option target="Release" />
		</Unit>
		<Unit filename="include/args.h" />
		<Unit filename="include/config.h" />
		<Unit filename="include/csv_reader.h" />
		<Unit filename="include/debug.h" />
		<Unit filename="include/generator.h" />
		<Unit filename="include/loader.h" />
		<Unit filename="include/name_data.h" />
		<Unit filename="include/normalize.h" />
		<Unit filename="include/output.h" />
		<Unit filename="include/split_names.h" />
		<Unit filename="include/version.h" />
		<Unit filename="src/args.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/config.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/csv_reader.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/debug.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/generator.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/loader.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/main.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/name_data.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/names.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/normalize.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/output.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/split_names.c">
			<Option compilerVar="CC" />
		</Unit>
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
